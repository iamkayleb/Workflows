# Consumer repo secrets template
#
# Copy this file somewhere OUTSIDE the repo (or to .env which is gitignored),
# fill in the real values, then run:
#
#   scripts/bulk-set-secrets.sh owner/new-consumer-repo path/to/your.env
#
# Never commit a file with real secret values.

# ---- Agent API keys (choose the agents you want to enable) ----

# Claude: prefer the OAuth token.  CLAUDE_AUTH_JSON is the legacy fallback.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Codex: JSON blob from `codex auth export` (one line, escaped).
CODEX_AUTH_JSON={"api_key":"sk-..."}

# Gemini: API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# ---- GitHub App credentials used by the reusable workflows ----

# App ID (numeric, from the app's settings page)
WORKFLOWS_APP_ID=123456

# Private key — use the @file syntax to load a multi-line PEM:
WORKFLOWS_APP_PRIVATE_KEY=@/absolute/path/to/workflows-app.private-key.pem

# Optional keepalive-specific app (falls back to WORKFLOWS_APP_* if unset)
# KEEPALIVE_APP_ID=123457
# KEEPALIVE_APP_PRIVATE_KEY=@/absolute/path/to/keepalive-app.pem

# ---- Service bot PATs ----

# Used by intake/bridge for comments, labels, PR creation
SERVICE_BOT_PAT=ghp_...
OWNER_PR_PAT=ghp_...

# Optional extra PATs (only needed if your workflows reference them)
# ACTIONS_BOT_PAT=ghp_...
# AGENTS_AUTOMATION_PAT=ghp_...
